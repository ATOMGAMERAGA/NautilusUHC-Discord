# ============================================================
# NautilusUHC Discord botu — ortam değişkenleri
# Coolify/Dokploy panelinde gir. Kopyala: cp .env.example .env
# ============================================================

# --- ZORUNLU ---
# Discord Developer Portal > Bot > Token. (SERVER MEMBERS + MESSAGE CONTENT
# intent'lerini açmayı unutma.)
DISCORD_TOKEN=

# Plugin ile paylaşılan gizli anahtar — plugin config.yml > bridge.token ile
# BİREBİR aynı olmalı. Uzun, rastgele bir değer üret.
BRIDGE_SECRET=

# Plugin köprü API'sinin adresi (Pelican host + bridge portu, yol EKLEMEDEN).
# Örn: http://1.2.3.4:8571
MC_API_URL=

# --- OPSİYONEL (Nautilus PvP varsayılanları koda gömülü) ---
# Botun dinleyeceği port (plugin buraya olay POST'lar; Coolify/Dokploy açar).
PORT=8080
# SQLite veri yolu (Coolify/Dokploy'da /app/data volume'una bağla).
DB_PATH=data/bot.db

# Botun hizmet vereceği TEK sunucu (başka sunucudan otomatik ayrılır).
GUILD_ID=1521979737201836233
# Maç duyurularının düşeceği kanal.
MATCH_CHANNEL_ID=1522216307809063154
# Hesap bağlama panelinin atılacağı kanal.
LINK_CHANNEL_ID=1522335045593858228
# Moderasyon/güvenlik log kanalı (boşsa /admin logkanal ile ayarlanır).
LOG_CHANNEL_ID=

# Yetki rolleri (id).
ROLE_KURUCU=1522149038298894450
ROLE_ADMIN=1522149134830800946
ROLE_BMOD=1522149269568622733
ROLE_MOD=1522149408555139072
ROLE_REHBER=1522149952527138889
