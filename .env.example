# ============================================================
# NautilusUHC Discord botu — ortam değişkenleri
# Coolify/Dokploy panelinde gir. Kopyala: cp .env.example .env
# ============================================================

# --- ZORUNLU ---
# Discord Developer Portal > Bot > Token. (SERVER MEMBERS + MESSAGE CONTENT
# intent'lerini açmayı unutma.)
DISCORD_TOKEN=

# Plugin ile paylaşılan gizli anahtar — plugin config.yml > bridge.token ile
# BİREBİR aynı olmalı. Uzun, rastgele bir değer üret.
BRIDGE_SECRET=

# --- ESKİ / OPSİYONEL: BOŞ BIRAK ---
# TERS KÖPRÜ düzeninde plugin BOTA bağlanır (POST /api/event + uzun-yoklama
# GET /api/bridge/jobs), Minecraft sunucusunda hiçbir port açık değildir.
# Bot, plugin bağlıyken tüm istekleri iş kuyruğundan geçirir ve buraya HİÇ
# bakmaz. Bu değişken yalnızca plugin ters köprüye bağlı DEĞİLKEN devreye giren
# eski doğrudan-bağlantı yedeğidir. Örn (artık önerilmez): http://1.2.3.4:25000
#
# DİKKAT — buraya BOTUN KENDİ adresini (aşağıdaki BOT_PUBLIC_URL) YAZMA.
# Bot kendi /api/link/verify ucunu tanımaz; kendine attığı istek
# 404 {"error":"not_found"} döner ve oyuncular doğru kodu girdikleri hâlde
# "Kod geçersiz veya süresi dolmuş" görürler. Böyle bir değer açılışta
# reddedilir ([config] hata satırı) ve doğrudan yedek KAPATILIR.
# Dolu bırakacaksan MUTLAK bir http:// veya https:// adresi olmalı.
MC_API_URL=

# Botun dışarıdan erişilen adresi (Dokploy/Coolify domaini — plugin
# config.yml > bridge.bot-url ile aynı değer). Yalnız teşhis içindir: MC_API_URL
# yanlışlıkla bu adrese ayarlanırsa açılışta yakalanır. Örn:
BOT_PUBLIC_URL=https://bot.nautilusuhc.com

# --- OPSİYONEL (Nautilus PvP varsayılanları koda gömülü) ---
# Botun dinleyeceği port. Plugin buraya olay POST'lar ve iş çeker; site de
# /api/v1/stats/* uçlarını buradan okur. Dokploy/Coolify'da domaine bağla.
PORT=25000
# SQLite veri yolu (Coolify/Dokploy'da /app/data volume'una bağla).
DB_PATH=data/bot.db

# Botun hizmet vereceği TEK sunucu (başka sunucudan otomatik ayrılır).
GUILD_ID=1521979737201836233
# Maç duyurularının düşeceği kanal.
MATCH_CHANNEL_ID=1522216307809063154
# Hesap bağlama panelinin atılacağı kanal.
LINK_CHANNEL_ID=1522335045593858228
# Moderasyon/güvenlik log kanalı (boşsa /admin logkanal ile ayarlanır).
LOG_CHANNEL_ID=

# Yetki rolleri (id).
ROLE_KURUCU=1522149038298894450
ROLE_ADMIN=1522149134830800946
ROLE_BMOD=1522149269568622733
ROLE_MOD=1522149408555139072
ROLE_REHBER=1522149952527138889

# --- OPSİYONEL: PLUGIN TARAFI (bot değil, referans) ---
# Aynı BRIDGE_SECRET ile birden fazla Minecraft sunucusu köprüye bağlanırsa
# hesap bağlama doğrulaması rastgele birine gider ve kodu üretmeyen sunucu
# "invalid_code" döner. Bot bu durumu tespit edip isteği BLOKLAR (belirgin hata).
# Kesin ayrım için her plugin instance'ına ayrı bir kimlik ver; plugin bunu
# yoklama isteklerinde `X-Bridge-Instance` başlığıyla gönderir:
#   BRIDGE_INSTANCE_ID=mc-canli
# Başlığı göndermeyen eski pluginler çalışmaya devam eder (IP'den kimlik
# türetilir), ancak aynı IP arkasındaki iki sunucu ayırt edilemez.
